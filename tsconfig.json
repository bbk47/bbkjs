{
    "compilerOptions": {
        "target": "ES2020",
        "module": "commonjs",
        "lib": ["ES2020"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "outDir": "./out",
        "rootDir": ".",
        "declaration": true,
        "sourceMap": true
    },
    "include": ["src/**/*", "bin/**/*"],
    "exclude": ["node_modules", "dist", "out"]
}
